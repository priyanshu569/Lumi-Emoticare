# Required — used by the browser and SSR Supabase client
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-anon-key"

# Optional — not read by the app directly, kept for reference
VITE_SUPABASE_PROJECT_ID="your-project-id"

# Optional — only needed if you wire up src/integrations/supabase/client.server.ts
# (admin client, bypasses RLS). Never expose this key to the browser.
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
